#!/usr/bin/env python3
"""logbook - helpers for the FAIR Lab planning repo.

The GitHub issues in USAFA-AI-Center/fair_lab_planning are the source of truth.
Every command reads the issue first and derives everything else from it.

  Two commands do the work, and they touch different things:

  logbook schedule <issue#> --start <period> (--count N | --until <period>)
      ISSUES ONLY. Create the recurrence sub-issues for a recurring line of
      effort, one per period, each a child of the parent with its due date on
      the board and its record path in the body. Nothing in the repo changes.
      Existing periods are skipped, so re-running is safe.

  logbook record <issue#>
      ONE FILE ONLY. Start the report for an issue: create a branch from
      origin/main and write the record file from the issue's template with the
      header filled in. Give it a recurrence sub-issue (from schedule) or a
      one-off issue. For a recurring parent, add --period to pick the cycle;
      that cycle's sub-issue must already exist.

  logbook submit [--dry-run]
      Finish the report: commit the record on the current record/ branch, push
      it, and open the PR with the Closes / Refs lines filled in. Refuses while
      the record still carries the unfilled marker.

  logbook template <issue#> [--set [--from FILE]]
      Show the template an issue's records render from and where it came from.
      --set writes a "## Template" block into the issue body (the built-in
      default, or FILE), replacing an existing block, for the driver to edit.

  Who may act: only an assignee of the issue (for a recurrence, of the
  sub-issue or its parent) may schedule, record, submit, or set its template,
  and the PR check fails a PR whose author is not one. The Driver line in the
  body is prose; the assignee list is the identity GitHub can verify, so
  assign the driver on GitHub before records are written.

  Templates live in the issues, never in docs/. A record is rendered from, in
  order: the fenced block under "## Template" in the issue's own body; the block
  in the issue named by a "**Template:** #N" line (one form shared by several
  lines of effort); else the built-in default for a recurring or one-off issue.
  Fields: {{title}} {{parent}} {{sub_issue}} {{driver}} {{period}} {{date}}
  {{issue}}. Every generated file carries an "unfilled" marker line; delete it
  when the record is written. The lint fails if a closed issue's record still
  carries it.

  Periods by cadence: weekly 2026-W40 (due Sunday), monthly 2026-10, quarterly
  2026-Q4, semester 2026-fall (due Dec 15) / 2027-spring (due May 15),
  annual 2026. All others are due on the period's last day.

  logbook doc <issue#> [--set]
      Print the Doc path an issue should have (its exact title, spaces as
      underscores, path-unsafe characters dropped; a folder for recurring and
      standing issues, a .md file otherwise). --set writes it into the body.

  logbook check [--pr N]
      Without --pr: lint the docs/ tree. With --pr: for every issue the PR
      closes, its record must be in the PR and no longer carry the unfilled
      marker. Exit 1 on failure.

Needs: python3 (standard library only) and the gh CLI, authenticated.
"""

import argparse
import calendar
import datetime as dt
import json
import pathlib
import re
import subprocess
import sys

ORG = "USAFA-AI-Center"
REPO = f"{ORG}/fair_lab_planning"
PROJECT = "3"
import os
ROOT = pathlib.Path(os.environ.get("LOE_ROOT") or pathlib.Path(__file__).resolve().parent.parent)
RECURRENCE_LABEL = "recurrence"
RECURRING = ("weekly", "monthly", "quarterly", "semester", "annual")
UNFILLED = "<!-- unfilled: delete this line when the record is written -->"
MAX_PERIODS = 520

DEFAULT_RECORD = """\
# {{title}}: {{period}}

- **Issue:** #{{sub_issue}} (recurrence of #{{parent}})
- **Driver:** {{driver}}
- **Cycle:** {{period}}
- **Recorded:** {{date}}

## What happened

Two to five sentences.

## Who was involved

Attendees, recipients, or the department engaged.

## What changed as a result

Decisions made, requests received, follow-ups filed (issue numbers).

## Next time

What to do differently in the next cycle.
"""

DEFAULT_COMPLETION = """\
# {{title}}

- **Issue:** #{{issue}}
- **Driver:** {{driver}}
- **Completed:** {{date}}

## What was done

Two to five sentences. What exists now that did not before.

## Evidence

Links: the deployed thing, the document delivered, the email sent, the repo, the photo.
Anything a reader can open to confirm the work.

## Follow-ups filed

- #NN <title> (or "none")
"""

TEMPLATE_BLOCK = re.compile(r"^## Template\s*\n(`{3,})[a-z]*\n(.*?)\n\1[ \t]*$", re.S | re.M)

# Due day inside a period. Monthly, quarterly and annual periods are due on
# their last day; semesters are due on a fixed day near the end of classes.
SEMESTER_DUE = {"fall": (12, 15), "spring": (5, 15)}


# --------------------------------------------------------------------------- gh
def gh(*args, ok=(0,)):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode not in ok:
        sys.exit(f"gh {' '.join(args[:3])} failed:\n{r.stderr.strip()}")
    return r.stdout


def gql(query):
    return json.loads(gh("api", "graphql", "-f", f"query={query}"))["data"]


def git(*args, ok=(0,)):
    r = subprocess.run(["git", *args], capture_output=True, text=True, cwd=ROOT)
    if r.returncode not in ok:
        sys.exit(f"git {' '.join(args)} failed:\n{r.stderr.strip()}")
    return r.stdout.strip()


# ------------------------------------------------------------------------ issues
def load_issue(n):
    raw = json.loads(gh("issue", "view", str(n), "-R", REPO,
                        "--json", "number,title,body,labels,id,url,state,assignees"))
    body = raw["body"] or ""
    labels = {l["name"] for l in raw["labels"]}
    cad = next((l.split(":", 1)[1] for l in labels if l.startswith("cadence:")), None)
    m = re.search(r"\*\*Driver:\*\*\s*(.+)", body)
    driver = m.group(1).strip().strip("_") if m else ""
    m = re.search(r"\*\*Doc:\*\*\s*`([^`]+)`", body)
    doc = m.group(1).strip() if m else None
    m = re.search(r"\*\*Record:\*\*\s*`?([^`\s]+)`?", body)
    record = m.group(1).strip() if m else None
    m = re.search(r"\*\*Parent:\*\*\s*#(\d+)", body)
    parent = int(m.group(1)) if m else None
    m = re.search(r"\*\*Template:\*\*\s*#(\d+)", body)
    template_ref = int(m.group(1)) if m else None
    m = TEMPLATE_BLOCK.search(body)
    template_text = m.group(2) + "\n" if m else None
    return dict(raw, labels=labels, cadence=cad, driver=driver, doc=doc,
                record=record, parent=parent, template_ref=template_ref,
                template_text=template_text,
                assignees={x["login"] for x in raw.get("assignees") or []})


_me = {}


def me():
    if not _me:
        _me["login"] = json.loads(gh("api", "user"))["login"]
    return _me["login"]


def owners(iss):
    """Logins allowed to act on an issue: its assignees, plus its parent's for a recurrence."""
    who = set(iss["assignees"])
    if iss["parent"]:
        who |= load_issue(iss["parent"])["assignees"]
    return who


def require_owner(iss, login=None, action="act on"):
    login = login or me()
    allowed = owners(iss)
    if not allowed:
        sys.exit(f"#{iss['number']} has no assignee. Assign the driver on GitHub first; "
                 "only an assignee may " + action + " it.")
    if login not in allowed:
        sys.exit(f"@{login} is not an assignee of #{iss['number']} "
                 f"(assignees: {', '.join('@' + a for a in sorted(allowed))}); only they may {action} it.")


def title_slug(title):
    """Doc path stem: the exact title, spaces as underscores, path-unsafe characters dropped."""
    t = re.sub(r'[\\/:*?"<>|]+', " ", title)
    t = re.sub(r"\s+", "_", t.strip())
    return re.sub(r"_+", "_", t).strip("_")


def doc_path_for(iss):
    living = iss["cadence"] in RECURRING or iss["cadence"] is None
    return f"docs/{title_slug(iss['title'])}" + ("/" if living else ".md")


def is_living(iss):
    return bool(iss["doc"]) and iss["doc"].endswith("/")


def slug_dir(iss):
    if not iss["doc"]:
        sys.exit(f"#{iss['number']} has no **Doc:** line in its body; add one first.")
    return ROOT / iss["doc"]


# ----------------------------------------------------------------------- periods
def default_period(cad, today=None):
    d = today or dt.date.today()
    if cad == "weekly":
        y, w, _ = d.isocalendar()
        return f"{y}-W{w:02d}"
    if cad == "monthly":
        return f"{d.year}-{d.month:02d}"
    if cad == "quarterly":
        return f"{d.year}-Q{(d.month - 1) // 3 + 1}"
    if cad == "semester":
        return f"{d.year}-{'fall' if d.month >= 7 else 'spring'}"
    if cad == "annual":
        return str(d.year)
    return d.isoformat()


def parse_period(cad, p):
    """Return (year, index) for the cadence, or exit with the expected format."""
    fmt = {"weekly": r"^(\d{4})-W(\d{2})$",
           "monthly": r"^(\d{4})-(\d{2})$", "quarterly": r"^(\d{4})-Q([1-4])$",
           "semester": r"^(\d{4})-(fall|spring)$", "annual": r"^(\d{4})$"}
    if cad not in fmt:
        sys.exit(f"cadence {cad!r} is not recurring; schedule only works on "
                 f"{', '.join(RECURRING)} issues.")
    m = re.match(fmt[cad], p)
    if not m:
        example = {"weekly": "2026-W40", "monthly": "2026-10", "quarterly": "2026-Q4",
                   "semester": "2026-fall", "annual": "2026"}[cad]
        sys.exit(f"period {p!r} does not match the {cad} format, e.g. {example}")
    y = int(m.group(1))
    if cad == "weekly":
        i = int(m.group(2))
        try:
            dt.date.fromisocalendar(y, i, 1)
        except ValueError:
            sys.exit(f"{y} has no ISO week {i}")
    elif cad == "monthly":
        i = int(m.group(2))
        if not 1 <= i <= 12:
            sys.exit(f"month {i} out of range")
    elif cad == "quarterly":
        i = int(m.group(2))
    elif cad == "semester":
        i = 0 if m.group(2) == "spring" else 1
    else:
        i = 0
    return y, i


def format_period(cad, y, i):
    if cad == "weekly":
        return f"{y}-W{i:02d}"
    if cad == "monthly":
        return f"{y}-{i:02d}"
    if cad == "quarterly":
        return f"{y}-Q{i}"
    if cad == "semester":
        return f"{y}-{'spring' if i == 0 else 'fall'}"
    return str(y)


def next_period(cad, y, i):
    if cad == "weekly":
        ny, nw, _ = (dt.date.fromisocalendar(y, i, 1) + dt.timedelta(days=7)).isocalendar()
        return ny, nw
    if cad == "monthly":
        return (y + 1, 1) if i == 12 else (y, i + 1)
    if cad == "quarterly":
        return (y + 1, 1) if i == 4 else (y, i + 1)
    if cad == "semester":
        return (y + 1, 0) if i == 1 else (y, 1)
    return y + 1, 0


def period_sequence(cad, start, count=None, until=None):
    y, i = parse_period(cad, start)
    if until:
        parse_period(cad, until)
    out = []
    while True:
        p = format_period(cad, y, i)
        out.append(p)
        if (count and len(out) >= count) or (until and p == until):
            return out
        if len(out) >= MAX_PERIODS:
            sys.exit(f"--until {until} was not reached within {MAX_PERIODS} periods of {start}; "
                     "is it before the start?")
        y, i = next_period(cad, y, i)


def due_date(cad, p):
    y, i = parse_period(cad, p)
    if cad == "weekly":
        return dt.date.fromisocalendar(y, i, 7)
    if cad == "monthly":
        return dt.date(y, i, calendar.monthrange(y, i)[1])
    if cad == "quarterly":
        m = i * 3
        return dt.date(y, m, calendar.monthrange(y, m)[1])
    if cad == "semester":
        mm, dd = SEMESTER_DUE["spring" if i == 0 else "fall"]
        return dt.date(y, mm, dd)
    return dt.date(y, 12, 31)


# ----------------------------------------------------------------------- project
_project = {}


def project():
    if not _project:
        pv = json.loads(gh("project", "view", PROJECT, "--owner", ORG, "--format", "json"))
        fl = json.loads(gh("project", "field-list", PROJECT, "--owner", ORG, "--format", "json"))["fields"]
        f = {x["name"]: x for x in fl}
        _project.update(
            id=pv["id"],
            status=f["Status"]["id"],
            todo=next(o["id"] for o in f["Status"]["options"] if o["name"] == "Todo"),
            due=f["Target date"]["id"],
        )
    return _project


def add_to_board(url, due):
    p = project()
    item = json.loads(gh("project", "item-add", PROJECT, "--owner", ORG, "--url", url,
                         "--format", "json"))["id"]
    gh("project", "item-edit", "--project-id", p["id"], "--id", item,
       "--field-id", p["status"], "--single-select-option-id", p["todo"])
    if due:
        gh("project", "item-edit", "--project-id", p["id"], "--id", item,
           "--field-id", p["due"], "--date", due.isoformat())


# -------------------------------------------------------------------- sub-issues
def sub_title(parent, period):
    return f"{parent['title']}: {period}"


def find_sub(parent, period):
    title = sub_title(parent, period)
    hits = json.loads(gh("issue", "list", "-R", REPO, "--state", "all", "--limit", "100",
                         "--search", f'"{title}" in:title', "--json", "number,title,url"))
    return next((h for h in hits if h["title"] == title), None)


def ensure_label():
    have = {x["name"] for x in json.loads(gh("label", "list", "-R", REPO, "--json", "name", "--limit", "200"))}
    if RECURRENCE_LABEL not in have:
        gh("label", "create", RECURRENCE_LABEL, "-R", REPO, "--color", "bfdadc",
           "--description", "One cycle of a recurring line of effort")


def create_sub(parent, period):
    cad = parent["cadence"]
    due = due_date(cad, period)
    record = f"{parent['doc']}{period}.md"
    body = "\n".join([
        f"**Parent:** #{parent['number']}",
        f"**Cycle:** {period}",
        f"**Record:** `{record}`",
        f"**Due:** {due.isoformat()}",
        "",
        f"The PR that adds the record says `Closes #<this issue>` and `Refs #{parent['number']}`.",
        "Generated by `bin/logbook`.",
    ])
    ensure_label()
    url = gh("issue", "create", "-R", REPO, "--title", sub_title(parent, period),
             "--body", body, "--label", RECURRENCE_LABEL).strip()
    sub = json.loads(gh("issue", "view", url, "--json", "number,id,url"))
    gql(f'mutation {{ addSubIssue(input:{{issueId:"{parent["id"]}", subIssueId:"{sub["id"]}"}}) '
        f'{{ issue {{ id }} }} }}')
    add_to_board(url, due)
    return dict(sub, title=sub_title(parent, period), due=due)


# --------------------------------------------------------------------- templates
def template_for(iss):
    """(text, source) of the template an issue's records render from."""
    if iss["template_text"]:
        return iss["template_text"], f"## Template block in #{iss['number']}"
    if iss["template_ref"]:
        other = load_issue(iss["template_ref"])
        if not other["template_text"]:
            sys.exit(f"#{iss['number']} says **Template:** #{other['number']}, "
                     f"but #{other['number']} has no ## Template block")
        return other["template_text"], f"## Template block in #{other['number']}"
    if is_living(iss):
        return DEFAULT_RECORD, "built-in default (recurring)"
    return DEFAULT_COMPLETION, "built-in default (one-off)"


def render(template, **fields):
    text, source = template
    for k, v in fields.items():
        text = text.replace("{{" + k + "}}", str(v))
    left = re.findall(r"{{(\w+)}}", text)
    if left:
        sys.exit(f"template ({source}) has unknown fields: {left}")
    first, _, rest = text.partition("\n")
    return f"{first}\n{UNFILLED}\n{rest}"


def write_new(path, text):
    if path.exists():
        sys.exit(f"{path.relative_to(ROOT)} already exists; not overwriting.")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    print(f"wrote {path.relative_to(ROOT)}")


# ---------------------------------------------------------------------- commands
def start_branch(name):
    """Create record branch <name> from origin/main, or stay on it if already there."""
    current = git("rev-parse", "--abbrev-ref", "HEAD")
    if current == name:
        return
    if current.startswith("record/"):
        sys.exit(f"you are on {current}; finish it with `logbook submit` or switch to main first.")
    git("fetch", "-q", "origin")
    exists = git("branch", "--list", name)
    if exists:
        git("switch", "-q", name)
    else:
        git("switch", "-q", "-c", name, "origin/main")
    print(f"on branch {name}")


def cmd_record(a):
    iss = load_issue(a.issue)
    today = dt.date.today().isoformat()

    # A recurrence sub-issue (made by schedule): its body names the record path.
    if iss["record"] and iss["parent"]:
        require_owner(iss, action="record")
        parent = load_issue(iss["parent"])
        m = re.search(r"\*\*Cycle:\*\*\s*(\S+)", iss["body"])
        period = m.group(1) if m else "cycle"
        start_branch(f"record/{title_slug(parent['title'])}-{period}")
        text = render(template_for(parent), title=parent["title"], parent=parent["number"],
                      sub_issue=iss["number"], driver=parent["driver"], period=period, date=today,
                      issue=iss["number"])
        write_new(ROOT / iss["record"], text)
        print(f"write the report, delete the unfilled line, then: logbook submit   (Closes #{iss['number']}  Refs #{parent['number']})")
        return

    if not is_living(iss):
        require_owner(iss, action="record")
        start_branch(f"record/{title_slug(iss['title'])}")
        text = render(template_for(iss), title=iss["title"], issue=iss["number"],
                      driver=iss["driver"], date=today, parent="", sub_issue="", period="")
        write_new(slug_dir(iss), text)
        print(f"write the record, delete the unfilled line, then: logbook submit   (Closes #{iss['number']})")
        return

    # A recurring parent: pick the cycle, which must already have a sub-issue.
    cad = iss["cadence"]
    if cad not in RECURRING:
        sys.exit(f"#{iss['number']} is a standing line with no cadence; record its changes as "
                 "sub-issues you file by hand, then `logbook record <sub-issue#>`.")
    period = a.period or default_period(cad)
    parse_period(cad, period)
    sub = find_sub(iss, period)
    if sub is None:
        sys.exit(f"#{iss['number']} has no sub-issue for {period}. Run: "
                 f"logbook schedule {iss['number']} --start {period} --count 1")
    print(f"{period} is sub-issue #{sub['number']}")
    a.issue = sub["number"]
    cmd_record(a)


def record_files():
    """Record files changed on this branch relative to origin/main, plus untracked ones."""
    git("fetch", "-q", "origin")
    changed = git("diff", "--name-only", "origin/main...HEAD").splitlines()
    changed += git("diff", "--name-only", "HEAD").splitlines()
    changed += git("ls-files", "--others", "--exclude-standard").splitlines()
    return sorted({f for f in changed if f.startswith("docs/") and f.endswith(".md")
                   and not f.endswith("README.md") and (ROOT / f).exists()})


def cmd_submit(a):
    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if not branch.startswith("record/"):
        sys.exit(f"you are on {branch}; `logbook submit` runs on a record/ branch made by `logbook record`.")
    files = record_files()
    if not files:
        sys.exit("no record file changed on this branch.")
    closes, refs = [], []
    for f in files:
        text = (ROOT / f).read_text()
        if UNFILLED in text:
            sys.exit(f"{f} still carries the unfilled line; write the record and delete that line first.")
        m = re.search(r"\*\*Issue:\*\*\s*#(\d+)(?:\s*\(recurrence of #(\d+)\))?", text)
        if not m:
            sys.exit(f"{f} has no **Issue:** #N line.")
        closes.append(int(m.group(1)))
        if m.group(2):
            refs.append(int(m.group(2)))
    for n in closes:
        require_owner(load_issue(n), action="submit the record for")
    title = load_issue(closes[0])["title"]
    body = "  ".join([f"Closes #{n}" for n in closes] + [f"Refs #{n}" for n in sorted(set(refs))])
    msg = f"Record: {title}"
    steps = [["git", "add", *files], ["git", "commit", "-m", msg],
             ["git", "push", "-u", "origin", branch],
             ["gh", "pr", "create", "-R", REPO, "--head", branch, "--title", msg, "--body", body]]
    if a.dry_run:
        print("would run:")
        for st in steps:
            print("  " + " ".join(f'"{x}"' if " " in x else x for x in st))
        return
    git("add", *files)
    git("commit", "-q", "-m", msg)
    git("push", "-q", "-u", "origin", branch)
    url = gh("pr", "create", "-R", REPO, "--head", branch, "--title", msg, "--body", body).strip()
    print(f"PR opened: {url}\n  {body}")


def cmd_doc(a):
    iss = load_issue(a.issue)
    want = doc_path_for(iss)
    print(f"#{iss['number']} {iss['title']}\n  Doc: {want}" + ("" if iss["doc"] in (None, want) else f"  (issue says {iss['doc']})"))
    if a.set and iss["doc"] != want:
        body = iss["body"] or ""
        if iss["doc"]:
            body = body.replace(f"`{iss['doc']}`", f"`{want}`")
        else:
            body = re.sub(r"(\*\*Notes:\*\*.*\n)", rf"\1**Doc:** `{want}`\n", body, count=1) \
                if "**Notes:**" in body else f"**Doc:** `{want}`\n{body}"
        gh("issue", "edit", str(iss["number"]), "-R", REPO, "--body", body)
        print("  Doc line written to the issue")


def cmd_template(a):
    iss = load_issue(a.issue)
    if a.set:
        require_owner(iss, action="set the template of")
        text = pathlib.Path(a.source).read_text() if a.source else \
            (DEFAULT_RECORD if is_living(iss) else DEFAULT_COMPLETION)
        fence = "````" if "```" in text else "```"
        block = f"## Template\n{fence}markdown\n{text.rstrip()}\n{fence}"
        body = iss["body"] or ""
        if TEMPLATE_BLOCK.search(body):
            body = TEMPLATE_BLOCK.sub(lambda m: block, body, count=1)
            what = "replaced"
        else:
            body = body.rstrip() + "\n\n" + block + "\n"
            what = "added"
        gh("issue", "edit", str(iss["number"]), "-R", REPO, "--body", body)
        print(f"#{iss['number']}: ## Template block {what}")
        iss = load_issue(a.issue)
    text, source = template_for(iss)
    print(f"#{iss['number']} {iss['title']}\n  template source: {source}\n")
    print(text)


def cmd_schedule(a):
    iss = load_issue(a.issue)
    if not is_living(iss):
        sys.exit(f"#{iss['number']} is not a living document (its Doc is a file, not a folder).")
    require_owner(iss, action="schedule")
    periods = period_sequence(iss["cadence"], a.start, a.count, a.until)
    print(f"#{iss['number']} {iss['title']} ({iss['cadence']}): {len(periods)} periods")
    for p in periods:
        sub = find_sub(iss, p)
        if sub:
            print(f"  {p:<12} #{sub['number']:<4} exists")
        else:
            sub = create_sub(iss, p)
            print(f"  {p:<12} #{sub['number']:<4} created, due {sub['due']}")
    print("next: `logbook record <sub-issue#>` when a cycle's report is due.")


def lint_tree():
    problems, unfilled = [], []
    records = []
    # git does not track empty directories, so a fresh checkout may have no docs/ at all.
    docs = ROOT / "docs"
    for d in sorted(docs.iterdir()) if docs.is_dir() else []:
        if d.is_dir():
            for f in d.glob("*.md"):
                if f.name.upper().startswith("TEMPLATE"):
                    problems.append(f"{f.relative_to(ROOT)}: templates live in the issue body, not docs/")
                elif f.name != "README.md":
                    records.append(f)
        elif d.suffix == ".md":
            if d.name.upper().startswith("TEMPLATE"):
                problems.append(f"{d.relative_to(ROOT)}: templates live in the issue body, not docs/")
            else:
                records.append(d)
    for f in records:
        text = f.read_text()
        m = re.search(r"\*\*Issue:\*\*\s*#(\d+)", text)
        if not m:
            problems.append(f"{f.relative_to(ROOT)} has no **Issue:** #N line")
        elif UNFILLED in text:
            unfilled.append((int(m.group(1)), f))
    if unfilled:
        nums = sorted({n for n, _ in unfilled})
        state = {}
        for n in nums:
            state[n] = json.loads(gh("issue", "view", str(n), "-R", REPO, "--json", "state"))["state"]
        for n, f in unfilled:
            if state[n] == "CLOSED":
                problems.append(f"#{n} is closed but {f.relative_to(ROOT)} is still unfilled")
    return problems


def cmd_check(a):
    problems = lint_tree()
    if a.pr:
        pr = json.loads(gh("pr", "view", str(a.pr), "-R", REPO, "--json", "body,files,headRefOid,author"))
        files = [f["path"] for f in pr["files"]]
        head = pr["headRefOid"]
        author = pr["author"]["login"]

        def at_head(path):
            out = gh("api", f"repos/{REPO}/contents/{path}?ref={head}", "--jq", ".content", ok=(0, 1))
            import base64
            return base64.b64decode(out).decode() if out.strip() else ""
        closes = {int(n) for n in re.findall(
            r"(?i)\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s+#(\d+)", pr["body"] or "")}
        if not closes:
            print("PR closes no issue; only the tree lint applies.")
        for n in sorted(closes):
            iss = load_issue(n)
            if iss["record"]:
                want = iss["record"]
                hit = [want] if want in files else []
            elif iss["doc"] and not is_living(iss):
                want = iss["doc"]
                hit = [want] if want in files else []
            elif iss["doc"]:
                want = iss["doc"] + "<period>.md"
                hit = [f for f in files if f.startswith(iss["doc"]) and not f.endswith("README.md")]
            else:
                want, hit = "a **Doc:** line on the issue", []
            if not hit:
                print(f"  Closes #{n}: MISSING {want}")
                problems.append(f"PR closes #{n} but does not add {want}")
                continue
            unfilled = [f for f in hit if UNFILLED in at_head(f)]
            if unfilled:
                print(f"  Closes #{n}: UNFILLED {unfilled[0]}")
                problems.append(f"PR closes #{n} but {unfilled[0]} still carries the unfilled line")
                continue
            allowed = owners(iss)
            if author not in allowed:
                who = ", ".join("@" + x for x in sorted(allowed)) or "nobody assigned"
                print(f"  Closes #{n}: NOT DRIVER @{author} (assignees: {who})")
                problems.append(f"PR author @{author} is not an assignee of #{n} ({who})")
            else:
                print(f"  Closes #{n}: ok {hit[0]} by @{author}")
    for p in problems:
        print("FAIL", p)
    if problems:
        sys.exit(1)
    print("check passed")


def main():
    ap = argparse.ArgumentParser(prog="logbook", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    r = sp.add_parser("record", help="start a report: branch + record file from the issue's template")
    r.add_argument("issue", type=int, help="a recurrence sub-issue, a one-off issue, or a recurring parent with --period")
    r.add_argument("--period", help="for a recurring parent: the cycle (default: the current one)")
    r.set_defaults(fn=cmd_record)
    u = sp.add_parser("submit", help="commit, push, and open the PR for the record on this branch")
    u.add_argument("--dry-run", action="store_true", help="print the commands instead of running them")
    u.set_defaults(fn=cmd_submit)
    d = sp.add_parser("doc", help="print the Doc path an issue should have; --set writes it into the body")
    d.add_argument("issue", type=int)
    d.add_argument("--set", action="store_true")
    d.set_defaults(fn=cmd_doc)
    t = sp.add_parser("template", help="show an issue's template; --set writes a ## Template block into it")
    t.add_argument("issue", type=int)
    t.add_argument("--set", action="store_true")
    t.add_argument("--from", dest="source", help="file whose contents become the block (default: built-in)")
    t.set_defaults(fn=cmd_template)
    s = sp.add_parser("schedule", help="create N recurrence sub-issues with due dates")
    s.add_argument("issue", type=int)
    s.add_argument("--start", required=True, help="first period, e.g. 2026-10, 2026-Q4, 2026-fall, 2026")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--count", type=int, help="number of periods")
    g.add_argument("--until", help="last period, inclusive")
    s.set_defaults(fn=cmd_schedule)
    c = sp.add_parser("check", help="lint the tree; with --pr, verify the PR documents what it closes")
    c.add_argument("--pr", type=int)
    c.set_defaults(fn=cmd_check)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
