#!/usr/bin/env python3
"""logbook - the FAIR Lab planning bot and its command line.

The GitHub issues in USAFA-AI-Center/fair_lab_planning are the source of truth.
Every command reads the issue first and derives everything else from it.

People drive it with comments; the bot workflow runs `logbook handle`:

  on a new issue          writes its Doc line, puts it on the board, and posts
                          the commands that apply to it
  /schedule <first> [<last>]
                          on a recurring issue: one sub-issue per period, each
                          on the board as Todo with its due date as Target date.
                          Existing periods are skipped, so re-running is safe.
  /change <short name>    on a standing issue: file one change as a sub-issue
  /done                   on a one-off issue or a sub-issue, when the work is
                          finished: open the record PR from the issue's template
                          and reply with a link to write it. On a recurring or
                          standing parent, once every sub-issue is closed: open
                          its closeout record, which closes the parent
  /done                   on a record PR, when the record is written: check it
                          and merge it (or merge as soon as the check passes)
  /template               write the effective template into the issue body as a
                          "## Template" block, for the driver to edit
  /help                   list the commands

  Who may act: only an assignee of the issue (for a recurrence, of the
  sub-issue or its parent). The Driver line in the body is prose; the assignee
  list is the identity GitHub can verify.

  Templates live in the issues, never in docs/. A record is rendered from, in
  order: the fenced block under "## Template" in the issue's own body; the block
  in the issue named by a "**Template:** #N" line (one form shared by several
  lines of effort); else the built-in default for a recurring or one-off issue.
  Fields: {{title}} {{parent}} {{sub_issue}} {{driver}} {{period}} {{date}}
  {{issue}}. Keep the "**Issue:** #N" line; the check relies on it.

  Periods by cadence: weekly 2026-W40 (due Sunday), monthly 2026-10, quarterly
  2026-Q4, semester 2026-fall (due Dec 15) / 2027-spring (due May 15),
  annual 2026. All others are due on the period's last day.

Local commands (the same work the bot does, as yourself):

  logbook schedule <issue#> --start <period> (--count N | --until <period>)
  logbook template <issue#> [--set [--from FILE]]
  logbook doc <issue#> [--set]
  logbook check [--pr N]      lint docs/; with --pr, what the PR check runs
  logbook handle <event-name> <event.json>

Needs: python3 (standard library only) and the gh CLI, authenticated.
"""

import argparse
import base64
import calendar
import datetime as dt
import json
import os
import pathlib
import re
import subprocess
import sys
import urllib.parse
import zoneinfo

ORG = "USAFA-AI-Center"
REPO = f"{ORG}/fair_lab_planning"
PROJECT = "3"
BASE = "main"
ROOT = pathlib.Path(os.environ.get("LOGBOOK_ROOT") or pathlib.Path(__file__).resolve().parent.parent)
TZ = zoneinfo.ZoneInfo("America/Denver")
RECURRENCE_LABEL = "recurrence"
RECURRING = ("weekly", "monthly", "quarterly", "semester", "annual")
STANDING = "standing"
CLOSEOUT = "Closeout.md"  # the record that closes a recurring or standing parent
MAX_PERIODS = 520
SCAFFOLD_MSG = "logbook: scaffold record for #"
CLOSES = re.compile(r"(?i)\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s+#(\d+)")

DEFAULT_RECORD = """\
# {{title}}: {{period}}

- **Issue:** #{{sub_issue}} (recurrence of #{{parent}})
- **Driver:** {{driver}}
- **Period:** {{period}}
- **Recorded:** {{date}}

## What happened

_Two to five sentences._

## Who was involved

_Attendees, recipients, or the department engaged._

## What changed as a result

_Decisions made and requests received. List any new issues by number, e.g. #45._

## Next time

_What to do differently next period, or "nothing"._
"""

DEFAULT_COMPLETION = """\
# {{title}}

- **Issue:** #{{issue}}
- **Driver:** {{driver}}
- **Completed:** {{date}}

## What was done

_Two to five sentences: what exists now that did not before._

## Evidence

_Links anyone can open to confirm the work: the repo, the deployed site, the document, the email, a photo._

## Follow-ups filed

_New issues this work turned up, one per line, or "none". For example:_

- #45 Add a dark-mode version of the logo
"""

TEMPLATE_BLOCK = re.compile(r"^## Template\s*\n(`{3,})[a-z]*\n(.*?)\n\1[ \t]*$", re.S | re.M)

# Due day inside a period. Monthly, quarterly and annual periods are due on
# their last day; semesters are due on a fixed day near the end of classes.
SEMESTER_DUE = {"fall": (12, 15), "spring": (5, 15)}

# How far the example in a new recurring issue's welcome reaches, in periods.
EXAMPLE_SPAN = {"weekly": 10, "monthly": 8, "quarterly": 4, "semester": 2, "annual": 3}


class Refuse(Exception):
    """A request the bot declines, with the reason to show the person who asked."""


# --------------------------------------------------------------------------- gh
def gh(*args, ok=(0,)):
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode not in ok:
        sys.exit(f"gh {' '.join(args[:3])} failed:\n{r.stderr.strip()}")
    return r.stdout


def gh_found(*args):
    """stdout of a gh api call, or None when the resource does not exist (gh prints the 404 body)."""
    r = subprocess.run(["gh", *args], capture_output=True, text=True)
    if r.returncode == 0:
        return r.stdout
    if "HTTP 404" in r.stderr:
        return None
    sys.exit(f"gh {' '.join(args[:3])} failed:\n{r.stderr.strip()}")


def gql(query):
    return json.loads(gh("api", "graphql", "-f", f"query={query}"))["data"]


def today():
    return dt.datetime.now(TZ).date()


# ------------------------------------------------------------------------ issues
def load_issue(n):
    raw = json.loads(gh("issue", "view", str(n), "-R", REPO,
                        "--json", "number,title,body,labels,id,url,state,assignees"))
    body = raw["body"] or ""
    labels = {l["name"] for l in raw["labels"]}
    cad = next((l.split(":", 1)[1] for l in labels if l.startswith("cadence:")), None)
    m = re.search(r"\*\*Driver:\*\*\s*(.+)", body)
    driver = m.group(1).strip().strip("_") if m else ""
    m = re.search(r"\*\*Doc:\*\*\s*`([^`]+)`", body)
    doc = m.group(1).strip() if m else None
    m = re.search(r"\*\*Record:\*\*\s*`?([^`\s]+)`?", body)
    record = m.group(1).strip() if m else None
    m = re.search(r"\*\*Parent:\*\*\s*#(\d+)", body)
    parent = int(m.group(1)) if m else None
    m = re.search(r"\*\*Cycle:\*\*\s*(\S+)", body)
    cycle = m.group(1) if m else None
    m = re.search(r"\*\*Template:\*\*\s*#(\d+)", body)
    template_ref = int(m.group(1)) if m else None
    m = TEMPLATE_BLOCK.search(body)
    template_text = m.group(2) + "\n" if m else None
    return dict(raw, body=body, labels=labels, cadence=cad, driver=driver, doc=doc,
                record=record, parent=parent, cycle=cycle, template_ref=template_ref,
                template_text=template_text,
                assignees={x["login"] for x in raw.get("assignees") or []})


_me = {}


def me():
    if not _me:
        _me["login"] = json.loads(gh("api", "user"))["login"]
    return _me["login"]


def owners(iss):
    """Logins allowed to act on an issue: its assignees, plus its parent's for a recurrence."""
    who = set(iss["assignees"])
    if iss["parent"]:
        who |= load_issue(iss["parent"])["assignees"]
    return who


def driver_of(iss):
    """The driver as the record names them: the assignees (the driver is the assignee in this repo)."""
    who = owners(iss)
    return ", ".join("@" + a for a in sorted(who)) if who else iss["driver"] or "unassigned"


def require_owner(iss, login, action="act on"):
    allowed = owners(iss)
    if not allowed:
        raise Refuse(f"#{iss['number']} has no assignee. Assign the driver on the issue first; "
                     f"only an assignee may {action} it.")
    if login not in allowed:
        raise Refuse(f"@{login} is not an assignee of #{iss['number']} "
                     f"(assignees: {', '.join('@' + a for a in sorted(allowed))}); "
                     f"only they may {action} it.")


def title_slug(title):
    """Doc path stem: the exact title, spaces as underscores, path-unsafe characters dropped."""
    t = re.sub(r'[\\/:*?"<>|]+', " ", title)
    t = re.sub(r"\s+", "_", t.strip())
    return re.sub(r"_+", "_", t).strip("_")


def doc_path_for(iss):
    living = iss["cadence"] in RECURRING + (STANDING,) or iss["cadence"] is None
    return f"docs/{title_slug(iss['title'])}" + ("/" if living else ".md")


def is_living(iss):
    return bool(iss["doc"]) and iss["doc"].endswith("/")


def kind(iss):
    """'sub' (a period or change), 'recurring', 'standing', 'once', or 'unset' (no cadence label)."""
    if iss["parent"] or RECURRENCE_LABEL in iss["labels"]:
        return "sub"
    if iss["cadence"] in RECURRING:
        return "recurring"
    if iss["cadence"] == STANDING:
        return "standing"
    if iss["cadence"] is None:
        return "unset"
    return "once"


def sync_doc(iss):
    """Write the Doc path the issue should have into its body. Returns the path if it changed."""
    want = doc_path_for(iss)
    if iss["doc"] == want:
        return None
    body = iss["body"]
    if iss["doc"]:
        body = body.replace(f"`{iss['doc']}`", f"`{want}`")
    elif re.search(r"^\*\*Doc:\*\*.*$", body, re.M):
        body = re.sub(r"^\*\*Doc:\*\*.*$", f"**Doc:** `{want}`", body, count=1, flags=re.M)
    elif "**Notes:**" in body:
        body = re.sub(r"(\*\*Notes:\*\*.*\n)", rf"\1**Doc:** `{want}`\n", body, count=1)
    else:
        body = f"**Doc:** `{want}`\n{body}"
    gh("issue", "edit", str(iss["number"]), "-R", REPO, "--body", body)
    iss.update(body=body, doc=want)
    return want


# ----------------------------------------------------------------------- periods
def default_period(cad, day=None):
    d = day or today()
    if cad == "weekly":
        y, w, _ = d.isocalendar()
        return f"{y}-W{w:02d}"
    if cad == "monthly":
        return f"{d.year}-{d.month:02d}"
    if cad == "quarterly":
        return f"{d.year}-Q{(d.month - 1) // 3 + 1}"
    if cad == "semester":
        return f"{d.year}-{'fall' if d.month >= 7 else 'spring'}"
    if cad == "annual":
        return str(d.year)
    return d.isoformat()


def first_period(cad, day=None):
    """The period a new schedule should start at: this one, or the next when this one ends within 10 days."""
    d = day or today()
    p = default_period(cad, d)
    if (due_date(cad, p) - d).days < 10:
        p = format_period(cad, *next_period(cad, *parse_period(cad, p)))
    return p


def parse_period(cad, p):
    """Return (year, index) for the cadence, or refuse with the expected format."""
    fmt = {"weekly": r"^(\d{4})-W(\d{2})$",
           "monthly": r"^(\d{4})-(\d{2})$", "quarterly": r"^(\d{4})-Q([1-4])$",
           "semester": r"^(\d{4})-(fall|spring)$", "annual": r"^(\d{4})$"}
    if cad not in fmt:
        raise Refuse(f"cadence {cad!r} is not recurring; periods only apply to "
                     f"{', '.join(RECURRING)} issues.")
    m = re.match(fmt[cad], p)
    if not m:
        example = {"weekly": "2026-W40", "monthly": "2026-10", "quarterly": "2026-Q4",
                   "semester": "2026-fall", "annual": "2026"}[cad]
        raise Refuse(f"period `{p}` does not match the {cad} format, e.g. `{example}`.")
    y = int(m.group(1))
    if cad == "weekly":
        i = int(m.group(2))
        try:
            dt.date.fromisocalendar(y, i, 1)
        except ValueError:
            raise Refuse(f"{y} has no ISO week {i}.")
    elif cad == "monthly":
        i = int(m.group(2))
        if not 1 <= i <= 12:
            raise Refuse(f"month {i} is out of range.")
    elif cad == "quarterly":
        i = int(m.group(2))
    elif cad == "semester":
        i = 0 if m.group(2) == "spring" else 1
    else:
        i = 0
    return y, i


def format_period(cad, y, i):
    if cad == "weekly":
        return f"{y}-W{i:02d}"
    if cad == "monthly":
        return f"{y}-{i:02d}"
    if cad == "quarterly":
        return f"{y}-Q{i}"
    if cad == "semester":
        return f"{y}-{'spring' if i == 0 else 'fall'}"
    return str(y)


def next_period(cad, y, i):
    if cad == "weekly":
        ny, nw, _ = (dt.date.fromisocalendar(y, i, 1) + dt.timedelta(days=7)).isocalendar()
        return ny, nw
    if cad == "monthly":
        return (y + 1, 1) if i == 12 else (y, i + 1)
    if cad == "quarterly":
        return (y + 1, 1) if i == 4 else (y, i + 1)
    if cad == "semester":
        return (y + 1, 0) if i == 1 else (y, 1)
    return y + 1, 0


def period_sequence(cad, start, count=None, until=None):
    y, i = parse_period(cad, start)
    if until:
        parse_period(cad, until)
    out = []
    while True:
        p = format_period(cad, y, i)
        out.append(p)
        if (count and len(out) >= count) or (until and p == until):
            return out
        if len(out) >= MAX_PERIODS:
            raise Refuse(f"`{until}` was not reached within {MAX_PERIODS} periods of `{start}`; "
                         "is it before the start?")
        y, i = next_period(cad, y, i)


def due_date(cad, p):
    y, i = parse_period(cad, p)
    if cad == "weekly":
        return dt.date.fromisocalendar(y, i, 7)
    if cad == "monthly":
        return dt.date(y, i, calendar.monthrange(y, i)[1])
    if cad == "quarterly":
        m = i * 3
        return dt.date(y, m, calendar.monthrange(y, m)[1])
    if cad == "semester":
        mm, dd = SEMESTER_DUE["spring" if i == 0 else "fall"]
        return dt.date(y, mm, dd)
    return dt.date(y, 12, 31)


# ----------------------------------------------------------------------- project
_project = {}


def project():
    if not _project:
        pv = json.loads(gh("project", "view", PROJECT, "--owner", ORG, "--format", "json"))
        fl = json.loads(gh("project", "field-list", PROJECT, "--owner", ORG, "--format", "json"))["fields"]
        f = {x["name"]: x for x in fl}
        opts = {o["name"]: o["id"] for o in f["Status"]["options"]}
        _project.update(id=pv["id"], status=f["Status"]["id"], due=f["Target date"]["id"],
                        options=opts)
    return _project


def set_board(url, status, due=None):
    """Put an issue on the board (a no-op if it is there) and set its Status, and Target date if given."""
    p = project()
    item = json.loads(gh("project", "item-add", PROJECT, "--owner", ORG, "--url", url,
                         "--format", "json"))["id"]
    gh("project", "item-edit", "--project-id", p["id"], "--id", item,
       "--field-id", p["status"], "--single-select-option-id", p["options"][status])
    if due:
        gh("project", "item-edit", "--project-id", p["id"], "--id", item,
           "--field-id", p["due"], "--date", due.isoformat())


# -------------------------------------------------------------------- sub-issues
def sub_title(parent, period):
    return f"{parent['title']}: {period}"


def subs_of(parent):
    pages = json.loads(gh("api", "--paginate", "--slurp",
                          f"repos/{REPO}/issues/{parent['number']}/sub_issues?per_page=100"))
    return [{"number": s["number"], "url": s["html_url"], "title": s["title"], "state": s["state"]}
            for page in pages for s in page]


def find_sub(parent, period):
    title = sub_title(parent, period)
    return next((s for s in subs_of(parent) if s["title"] == title), None)


def ensure_label():
    have = {x["name"] for x in json.loads(gh("label", "list", "-R", REPO, "--json", "name", "--limit", "200"))}
    if RECURRENCE_LABEL not in have:
        gh("label", "create", RECURRENCE_LABEL, "-R", REPO, "--color", "bfdadc",
           "--description", "One cycle of a recurring line of effort")


def create_sub(parent, cycle, due=None, name=None):
    """A sub-issue for one period (or, for a standing line, one change) of a parent."""
    title = sub_title(parent, name or cycle)
    body = "\n".join([
        f"**Parent:** #{parent['number']}",
        f"**Cycle:** {cycle}",
        f"**Record:** `{parent['doc']}{cycle}.md`",
    ] + ([f"**Due:** {due.isoformat()}"] if due else []) + [
        "",
        "When this work is done, comment `/done` here. The bot opens the record PR "
        "and replies with a link to write it.",
    ])
    ensure_label()
    url = gh("issue", "create", "-R", REPO, "--title", title,
             "--body", body, "--label", RECURRENCE_LABEL).strip()
    sub = json.loads(gh("issue", "view", url, "--json", "number,id,url"))
    gql(f'mutation {{ addSubIssue(input:{{issueId:"{parent["id"]}", subIssueId:"{sub["id"]}"}}) '
        f'{{ issue {{ id }} }} }}')
    set_board(url, "Todo", due)
    return dict(sub, title=title, due=due)


def file_change(iss, login, name):
    """A sub-issue for one change to a standing line; returns (number, url, created)."""
    if kind(iss) != "standing":
        raise Refuse(f"#{iss['number']} is not a standing responsibility; `/change` needs the "
                     f"`cadence:{STANDING}` label.")
    require_owner(iss, login, "file a change for")
    sync_doc(iss)
    sub = find_sub(iss, name)
    if sub:
        return sub["number"], sub["url"], False
    sub = create_sub(iss, f"{today().isoformat()}_{title_slug(name)}", name=name)
    return sub["number"], sub["url"], True


def schedule(iss, login, start, count=None, until=None):
    """Create the missing sub-issues for the periods; returns [(period, number, created, due)]."""
    if kind(iss) != "recurring":
        raise Refuse(f"#{iss['number']} is not a recurring issue; `/schedule` needs a "
                     f"`cadence:` label of {', '.join(RECURRING)}.")
    require_owner(iss, login, "schedule")
    sync_doc(iss)
    rows = []
    for p in period_sequence(iss["cadence"], start, count, until):
        sub = find_sub(iss, p)
        if sub:
            rows.append((p, sub["number"], False, due_date(iss["cadence"], p)))
        else:
            sub = create_sub(iss, p, due_date(iss["cadence"], p))
            rows.append((p, sub["number"], True, sub["due"]))
    return rows


# --------------------------------------------------------------------- templates
def template_for(iss):
    """(text, source) of the template an issue's records render from."""
    if iss["template_text"]:
        return iss["template_text"], f"## Template block in #{iss['number']}"
    if iss["template_ref"]:
        other = load_issue(iss["template_ref"])
        if not other["template_text"]:
            raise Refuse(f"#{iss['number']} says **Template:** #{other['number']}, "
                         f"but #{other['number']} has no ## Template block.")
        return other["template_text"], f"## Template block in #{other['number']}"
    if is_living(iss):
        return DEFAULT_RECORD, "built-in default (recurring)"
    return DEFAULT_COMPLETION, "built-in default (one-off)"


def render(template, **fields):
    text, source = template
    for k, v in fields.items():
        text = text.replace("{{" + k + "}}", str(v))
    left = re.findall(r"{{(\w+)}}", text)
    if left:
        raise Refuse(f"the template ({source}) has unknown fields: {left}.")
    return text


# The body the bot leaves on a new issue for /template to replace, and the text of the earlier
# Markdown issue template, which issues opened before the form still carry.
PLACEHOLDER = "Comment `/template` and the bot fills in this body."
OLD_TEMPLATE_TEXT = (
    "Leave this body blank. Create the issue, then comment `/template` and the bot fills it in.",
    "Before you click **Create**, set these in the sidebar:",
)
# Answers from the Line of effort issue form (.github/ISSUE_TEMPLATE/line-of-effort.yml).
FORM_ANSWER = re.compile(r"^### (Cadence|Kind)[ \t]*\n+[ \t]*(\S+)[ \t]*$", re.M)
KINDS = ("admin", "build", "infra", "integration", "report", "service")
BODY_FIELDS = (("Notes", "_context, links_"), ("Doc", None),
               ("Done means", "_what has to exist for this to be finished_"))


def set_template(iss, login, source_text=None):
    """Fill in the issue body: its fields, kept if already written, and the ## Template block."""
    require_owner(iss, login, "set the template of")
    sync_doc(iss)
    text = source_text or (DEFAULT_RECORD if is_living(iss) else DEFAULT_COMPLETION)
    fence = "````" if "```" in text else "```"
    block = f"## Template\n{fence}markdown\n{text.rstrip()}\n{fence}"
    what = "replaced" if TEMPLATE_BLOCK.search(iss["body"]) else "added"
    rest = TEMPLATE_BLOCK.sub("", iss["body"].replace("\r\n", "\n").replace(PLACEHOLDER, ""))
    if OLD_TEMPLATE_TEXT[0] in rest:
        # The old template's text ran from its first line to its last label bullet.
        rest = re.sub(re.escape(OLD_TEMPLATE_TEXT[0]) + r".*?`faculty-lecture`\.", "", rest, flags=re.S)
    fields = []
    for name, placeholder in BODY_FIELDS:
        pat = re.compile(rf"^\*\*{name}:\*\*[ \t]*(.*)$", re.M)
        m = pat.search(rest)
        value = f"`{iss['doc']}`" if name == "Doc" else (m.group(1).strip() if m and m.group(1).strip() else placeholder)
        fields.append(f"**{name}:** {value}")
        rest = pat.sub("", rest)
    rest = re.sub(r"\n{3,}", "\n\n", rest).strip()
    body = "\n".join(fields) + ("\n\n" + rest if rest else "") + "\n\n" + block + "\n"
    gh("issue", "edit", str(iss["number"]), "-R", REPO, "--body", body)
    return what


# ----------------------------------------------------------------------- records
def record_target(iss):
    """What a record for this issue closes, where it goes, and its rendered text."""
    k = kind(iss)
    date = today().isoformat()
    if k == "sub":
        if not iss["record"] or not iss["parent"]:
            raise Refuse(f"#{iss['number']} is a recurrence but has no **Parent:** and **Record:** lines.")
        parent = load_issue(iss["parent"])
        period = iss["cycle"] or "cycle"
        text = render(template_for(parent), title=parent["title"], parent=parent["number"],
                      sub_issue=iss["number"], driver=driver_of(iss), period=period,
                      date=date, issue=iss["number"])
        return dict(closes=iss["number"], refs=parent["number"], path=iss["record"],
                    title=iss["title"], text=text)
    if k == "once":
        sync_doc(iss)
        text = render(template_for(iss), title=iss["title"], issue=iss["number"],
                      driver=driver_of(iss), date=date, parent="", sub_issue="", period="")
        return dict(closes=iss["number"], refs=None, path=iss["doc"], title=iss["title"], text=text)
    if k in ("recurring", "standing"):
        # A parent closes only after every sub-issue has, with a closeout record of its own.
        still = [s for s in subs_of(iss) if s["state"] == "open"]
        if still:
            listed = "\n".join(f"- #{s['number']} {s['title']}" for s in still[:10])
            more = f"\n- and {len(still) - 10} more" if len(still) > 10 else ""
            raise Refuse(f"#{iss['number']} still has {len(still)} open sub-issue(s):\n\n{listed}{more}\n\n"
                         "Comment `/done` on each sub-issue when its work is done. When every one is "
                         "closed, `/done` here opens the closeout record that closes this issue.")
        sync_doc(iss)
        text = render((DEFAULT_COMPLETION, "built-in closeout"), title=f"{iss['title']}: closeout",
                      issue=iss["number"], driver=driver_of(iss), date=date, parent="", sub_issue="", period="")
        return dict(closes=iss["number"], refs=None, path=iss["doc"] + CLOSEOUT,
                    title=f"{iss['title']}: closeout", text=text)
    raise Refuse(f"#{iss['number']} has no `cadence:` label. Add one first.")


def quote(path):
    return urllib.parse.quote(path)


def file_at(path, ref):
    out = gh_found("api", f"repos/{REPO}/contents/{quote(path)}?ref={urllib.parse.quote(ref, safe='')}",
                   "--jq", ".content")
    return None if out is None else base64.b64decode(out).decode()


def edit_link(branch, path):
    return f"https://github.com/{REPO}/edit/{quote(branch)}/{quote(path)}"


def open_pr_for(branch):
    prs = json.loads(gh("pr", "list", "-R", REPO, "--head", branch, "--state", "open", "--json", "url"))
    return prs[0]["url"] if prs else None


def open_record_pr(t, assignees):
    """Branch, scaffold and PR for a record target. Returns (url, branch, created)."""
    if file_at(t["path"], BASE) is not None:
        raise Refuse(f"`{t['path']}` is already on {BASE}; #{t['closes']} has its record.")
    branch = f"record/{t['closes']}"
    url = open_pr_for(branch)
    if url:
        return url, branch, False
    try:
        return create_record_pr(t, assignees, branch), branch, True
    except SystemExit:
        # Two /done comments at once: the other run made the branch, file or PR first.
        url = open_pr_for(branch)
        if url:
            return url, branch, False
        raise


def create_record_pr(t, assignees, branch):
    if gh_found("api", f"repos/{REPO}/git/ref/heads/{branch}") is None:
        sha = gh("api", f"repos/{REPO}/git/ref/heads/{BASE}", "--jq", ".object.sha").strip()
        gh("api", "-X", "POST", f"repos/{REPO}/git/refs", "-f", f"ref=refs/heads/{branch}", "-f", f"sha={sha}")
    if file_at(t["path"], branch) is None:
        gh("api", "-X", "PUT", f"repos/{REPO}/contents/{quote(t['path'])}",
           "-f", f"message={SCAFFOLD_MSG}{t['closes']}",
           "-f", f"content={base64.b64encode(t['text'].encode()).decode()}",
           "-f", f"branch={branch}")
    lines = [f"Closes #{t['closes']}"] + ([f"Refs #{t['refs']}"] if t["refs"] else [])
    body = "\n".join(lines + [
        "",
        f"**Fill in the template:** [edit `{t['path']}`]({edit_link(branch, t['path'])})",
        "",
        "When it is filled in, comment `/done` on this PR and the bot merges it. "
        "To work locally instead: `git fetch origin && git switch " + branch + "`, edit, push.",
    ])
    args = ["pr", "create", "-R", REPO, "--head", branch, "--base", BASE,
            "--title", f"Record: {t['title']}", "--body", body]
    for a in sorted(assignees):
        args += ["--assignee", a]
    return gh(*args).strip()


# ------------------------------------------------------------------------- check
def lint_tree():
    problems, records = [], []
    # git does not track empty directories, so a fresh checkout may have no docs/ at all.
    docs = ROOT / "docs"
    for d in sorted(docs.iterdir()) if docs.is_dir() else []:
        files = sorted(d.glob("*.md")) if d.is_dir() else [d] if d.suffix == ".md" else []
        for f in files:
            if f.name.upper().startswith("TEMPLATE"):
                problems.append(f"{f.relative_to(ROOT)}: templates live in the issue body, not docs/")
            elif f.name != "README.md":
                records.append(f)
    for f in records:
        if not re.search(r"\*\*Issue:\*\*\s*#(\d+)", f.read_text()):
            problems.append(f"{f.relative_to(ROOT)} has no **Issue:** #N line")
    return problems


def record_path(iss):
    """The one file a PR closing this issue must add."""
    if iss["record"]:
        return iss["record"]
    if iss["doc"]:
        return iss["doc"] + CLOSEOUT if is_living(iss) else iss["doc"]
    return None


def pr_problems(number):
    """(problems, closes) for a PR: every issue it closes must get a written record."""
    pr = json.loads(gh("pr", "view", str(number), "-R", REPO, "--json", "body,files,headRefOid"))
    files = {f["path"] for f in pr["files"]}
    head = pr["headRefOid"]
    closes = sorted({int(n) for n in CLOSES.findall(pr["body"] or "")})
    commits = json.loads(gh("api", "--paginate", "--slurp", f"repos/{REPO}/pulls/{number}/commits?per_page=100"))
    scaffolds = [c["sha"] for page in commits for c in page
                 if c["commit"]["message"].startswith(SCAFFOLD_MSG)]
    problems = []
    for n in closes:
        iss = load_issue(n)
        want = record_path(iss)
        if want is None:
            problems.append(f"closes #{n}, which has no **Doc:** line")
            continue
        if want not in files:
            problems.append(f"closes #{n} but does not add `{want}`")
            continue
        text = file_at(want, head) or ""
        if any(file_at(want, sha) == text for sha in scaffolds):
            problems.append(f"`{want}` is still the unwritten scaffold; write the record first")
        elif not re.search(rf"\*\*Issue:\*\*\s*#{n}\b", text):
            problems.append(f"`{want}` has no `**Issue:** #{n}` line")
    return problems, closes


# --------------------------------------------------------------------------- bot
HELP = """\
**logbook commands** (only an assignee of the issue can run them):

| Where | Comment | What happens |
|---|---|---|
| recurring issue | `/schedule <first> [<last>]` | one sub-issue per period, e.g. `/schedule 2026-10 2027-05` |
| one-off issue or sub-issue | `/done` | the work is finished: the bot opens the record PR and links it |
| recurring or standing issue | `/done` | every sub-issue is closed: the bot opens the closeout record PR |
| standing issue | `/change <short name>` | files one change as a sub-issue |
| any issue but a sub-issue | `/template` | fills in the body and the record template |
| record PR | `/done` | the record is written: the bot checks it and merges it |
| anywhere | `/help` | this list |
"""


def welcome(iss):
    k = kind(iss)
    if k == "sub":
        lines = ["When this period's work is done, comment `/done` here."]
    elif k == "recurring":
        cad = iss["cadence"]
        span = period_sequence(cad, first_period(cad), EXAMPLE_SPAN[cad])
        lines = [f"This is a **{cad}** line of effort. Its records go in `{iss['doc']}`.",
                 "",
                 f"1. Comment `/schedule {span[0]} {span[-1]}` to create one sub-issue per period.",
                 "2. When a period's work is done, comment `/done` on that sub-issue.",
                 "3. Fill in the template on the PR the bot opens, then comment `/done` on the PR.",
                 "4. When the line of effort ends and every sub-issue is closed, comment `/done` here."]
    elif k == "once":
        lines = [f"This is a one-off. Its record goes in `{iss['doc']}`.",
                 "",
                 "1. When the work is done, comment `/done` here.",
                 "2. Fill in the template on the PR the bot opens, then comment `/done` on the PR."]
    elif k == "standing":
        lines = [f"This is a standing responsibility. Its records go in `{iss['doc']}`.",
                 "",
                 "1. For each discrete change, comment `/change <short name>`, e.g. `/change GPU rebuild`.",
                 "2. When the change is done, comment `/done` on the sub-issue the bot files.",
                 "3. Fill in the template on the PR the bot opens, then comment `/done` on the PR.",
                 "4. When the responsibility ends and every sub-issue is closed, comment `/done` here."]
    else:
        lines = ["This issue has no `cadence:` label. Add one (`cadence:once`, `cadence:monthly`, "
                 f"`cadence:{STANDING}`, ...) and the bot sets up its records."]
    if k in ("recurring", "once", "standing") and not iss["template_text"]:
        steps = [l for l in lines if re.match(r"\d+\. ", l)]
        lines = [l for l in lines if l not in steps] + [
            "1. Comment `/template` to fill in this issue's body and its record template."] + [
            re.sub(r"^\d+", str(i + 2), l) for i, l in enumerate(steps)]
    if not iss["assignees"]:
        lines += ["", "**Assign the driver first:** only an assignee can run these commands."]
    return "\n".join(lines + ["", "Comment `/help` for every command.", WELCOME_MARK.format(k)])


WELCOME_MARK = "<!-- logbook:welcome:{} -->"


def last_welcome(number):
    """The issue kind the bot's latest welcome on this issue was written for, or None."""
    pages = json.loads(gh("api", "--paginate", "--slurp", f"repos/{REPO}/issues/{number}/comments?per_page=100"))
    kinds = [m.group(1) for page in pages for c in page if c["user"]["type"] == "Bot"
             for m in [re.search(r"<!-- logbook:welcome:(\w+) -->", c["body"] or "")] if m]
    return kinds[-1] if kinds else None


def reply(number, text):
    gh("issue", "comment", str(number), "-R", REPO, "--body", text)


def react(comment_id, content="eyes"):
    gh("api", "-X", "POST", f"repos/{REPO}/issues/comments/{comment_id}/reactions",
       "-f", f"content={content}", ok=(0, 1))


def apply_form(iss):
    """Turn the issue form's Cadence and Kind answers into labels, and leave the placeholder body."""
    answers = {k.lower(): v for k, v in FORM_ANSWER.findall(iss["body"].replace("\r\n", "\n"))}
    if not answers:
        return False
    add = [f"cadence:{answers['cadence']}"] if answers.get("cadence") in RECURRING + ("once", STANDING) else []
    add += [f"kind:{answers['kind']}"] if answers.get("kind") in KINDS else []
    args = ["issue", "edit", str(iss["number"]), "-R", REPO, "--body", PLACEHOLDER]
    for label in add:
        args += ["--add-label", label]
    gh(*args)
    return True


def on_issue(action, payload):
    iss = load_issue(payload["issue"]["number"])
    if action == "opened" and apply_form(iss):
        iss = load_issue(iss["number"])
    if kind(iss) == "sub":
        if action == "opened":
            set_board(iss["url"], "Todo")
            reply(iss["number"], welcome(iss))
        return
    if action == "edited" and "title" not in (payload.get("changes") or {}):
        return
    if action in ("labeled", "unlabeled") and not payload["label"]["name"].startswith("cadence:"):
        return
    changed = sync_doc(iss)
    k = kind(iss)
    # Post the steps once per kind: a cadence label added later changes what the issue needs.
    prev = None if action == "opened" else last_welcome(iss["number"])
    if k != prev:
        set_board(iss["url"], "Recurring" if k in ("recurring", "standing") else "Todo")
    if k != prev or changed:
        note = f"Record path is now `{changed}`.\n\n" if changed and action != "opened" else ""
        reply(iss["number"], note + welcome(iss))


def issue_command(iss, login, cmd, args):
    if cmd == "/schedule":
        if not args:
            raise Refuse("Usage: `/schedule <first> [<last>]`, e.g. `/schedule 2026-10 2027-05`.")
        rows = schedule(iss, login, args[0], count=None if len(args) > 1 else 1,
                        until=args[1] if len(args) > 1 else None)
        table = "\n".join(f"| {p} | #{n} | {'created' if c else 'already existed'} | {d} |"
                          for p, n, c, d in rows)
        return ("| Period | Sub-issue | | Due |\n|---|---|---|---|\n" + table +
                "\n\nWhen a period's work is done, comment `/done` on its sub-issue.")
    if cmd == "/change":
        if not args:
            raise Refuse("Usage: `/change <short name>`, e.g. `/change GPU rebuild`.")
        n, url, created = file_change(iss, login, " ".join(args))
        return (f"{'Filed' if created else 'Already filed:'} #{n}. "
                "When the change is done, comment `/done` there.")
    if cmd == "/done":
        if args:
            raise Refuse("`/done` takes no arguments. For one period, comment `/done` on that period's sub-issue.")
        require_owner(iss, login, "record")
        t = record_target(iss)
        target = load_issue(t["closes"]) if t["closes"] != iss["number"] else iss
        url, branch, created = open_record_pr(t, owners(target))
        verb = "Opened" if created else "The record PR is already open:"
        return (f"{verb} {url}\n\n**Fill in the template:** [edit `{t['path']}`]({edit_link(branch, t['path'])})"
                "\n\nThen comment `/done` on the PR.")
    if cmd == "/template":
        if kind(iss) == "sub":
            if not iss["parent"]:
                raise Refuse("This sub-issue has no **Parent:** line, so it has no template to use.")
            parent = load_issue(iss["parent"])
            _, source = template_for(parent)
            where = (f"#{parent['number']} has one ({source}); edit it there."
                     if parent["template_text"] or parent["template_ref"] else
                     f"#{parent['number']} has none yet, so the default is used. "
                     f"Comment `/template` on #{parent['number']} to add it.")
            raise Refuse("A sub-issue's records use its parent's template, so nothing is added here. " + where)
        what = set_template(iss, login)
        return (f"Filled in this issue's body, with the record template {what} under `## Template`. "
                "Edit **Notes**, **Done means**, and the template there; every record opened after "
                "that follows the template.")
    raise Refuse(f"`{cmd}` is not a command here.\n\n{HELP}")


def pr_command(number, login, cmd):
    if cmd != "/done":
        raise Refuse(f"`{cmd}` is not a command on a PR.\n\n{HELP}")
    pr = json.loads(gh("pr", "view", str(number), "-R", REPO, "--json", "state,isDraft"))
    if pr["state"] != "OPEN":
        raise Refuse("This PR is not open.")
    problems, closes = pr_problems(number)
    if not closes:
        raise Refuse("This PR closes no issue, so there is no record to finish. `/done` is for record PRs.")
    for n in closes:
        require_owner(load_issue(n), login, "finish the record for")
    if problems:
        return "Not yet:\n\n" + "\n".join(f"- {p}" for p in problems) + "\n\nFix that, then comment `/done` again."
    if pr["isDraft"]:
        gh("pr", "ready", str(number), "-R", REPO)
    # A direct merge fails while the required check is still running; then queue it.
    gh("pr", "merge", str(number), "-R", REPO, "--squash", ok=(0, 1))
    if json.loads(gh("pr", "view", str(number), "-R", REPO, "--json", "state"))["state"] == "MERGED":
        return "Merged. " + ", ".join(f"#{n}" for n in closes) + " closed; the board moves it to Done."
    gh("pr", "merge", str(number), "-R", REPO, "--squash", "--auto")
    return "The record passes. The bot merges it as soon as the check finishes."


def on_comment(payload):
    body = (payload["comment"]["body"] or "").strip()
    if not body.startswith("/"):
        return
    words = body.splitlines()[0].split()
    cmd, args = words[0].lower(), words[1:]
    number = payload["issue"]["number"]
    login = payload["comment"]["user"]["login"]
    react(payload["comment"]["id"])
    if cmd == "/help":
        out = HELP
    elif "pull_request" in payload["issue"]:
        out = pr_command(number, login, cmd)
    else:
        out = issue_command(load_issue(number), login, cmd, args)
    reply(number, out)


def on_pr_closed(payload):
    pr = payload["pull_request"]
    if not pr.get("merged"):
        return
    for n in sorted({int(x) for x in CLOSES.findall(pr["body"] or "")}):
        set_board(load_issue(n)["url"], "Done")


def handle(event, payload):
    number = (payload.get("issue") or payload.get("pull_request") or {}).get("number")
    try:
        if event == "issues":
            on_issue(payload["action"], payload)
        elif event == "issue_comment" and payload["action"] == "created":
            on_comment(payload)
        elif event in ("pull_request", "pull_request_target") and payload["action"] == "closed":
            on_pr_closed(payload)
    except Refuse as r:
        if number:
            reply(number, str(r))
        print(f"refused: {r}")
    except (SystemExit, Exception) as e:
        run = os.environ.get("LOGBOOK_RUN_URL", "")
        detail = e.code if isinstance(e, SystemExit) else f"{type(e).__name__}: {e}"
        if number and event == "issue_comment":
            reply(number, "The bot hit an error and did nothing further"
                  + (f"; the run log has the details: {run}" if run else ".") + f"\n\n```\n{detail}\n```")
        raise


# ---------------------------------------------------------------------- commands
def cmd_handle(a):
    handle(a.event, json.loads(pathlib.Path(a.payload).read_text()))


def cmd_doc(a):
    iss = load_issue(a.issue)
    want = doc_path_for(iss)
    print(f"#{iss['number']} {iss['title']}\n  Doc: {want}" + ("" if iss["doc"] in (None, want) else f"  (issue says {iss['doc']})"))
    if a.set and sync_doc(iss):
        print("  Doc line written to the issue")


def cmd_template(a):
    iss = load_issue(a.issue)
    if a.set:
        what = set_template(iss, me(), pathlib.Path(a.source).read_text() if a.source else None)
        print(f"#{iss['number']}: ## Template block {what}")
        iss = load_issue(a.issue)
    text, source = template_for(iss)
    print(f"#{iss['number']} {iss['title']}\n  template source: {source}\n")
    print(text)


def cmd_schedule(a):
    iss = load_issue(a.issue)
    rows = schedule(iss, me(), a.start, a.count, a.until)
    print(f"#{iss['number']} {iss['title']} ({iss['cadence']}): {len(rows)} periods")
    for p, n, created, due in rows:
        print(f"  {p:<12} #{n:<4} {'created, due ' + str(due) if created else 'exists'}")


def cmd_check(a):
    problems = lint_tree()
    if a.pr:
        found, closes = pr_problems(a.pr)
        problems += found
        if not closes:
            print("PR closes no issue; only the tree lint applies.")
        for n in closes:
            print(f"  closes #{n}")
    for p in problems:
        print("FAIL", p)
    if problems:
        sys.exit(1)
    print("check passed")


def main():
    ap = argparse.ArgumentParser(prog="logbook", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = ap.add_subparsers(dest="cmd", required=True)
    h = sp.add_parser("handle", help="run the bot on a GitHub event (what the workflow calls)")
    h.add_argument("event", help="the event name, e.g. issue_comment")
    h.add_argument("payload", help="path to the event JSON")
    h.set_defaults(fn=cmd_handle)
    d = sp.add_parser("doc", help="print the Doc path an issue should have; --set writes it into the body")
    d.add_argument("issue", type=int)
    d.add_argument("--set", action="store_true")
    d.set_defaults(fn=cmd_doc)
    t = sp.add_parser("template", help="show an issue's template; --set writes a ## Template block into it")
    t.add_argument("issue", type=int)
    t.add_argument("--set", action="store_true")
    t.add_argument("--from", dest="source", help="file whose contents become the block (default: built-in)")
    t.set_defaults(fn=cmd_template)
    s = sp.add_parser("schedule", help="create recurrence sub-issues with due dates")
    s.add_argument("issue", type=int)
    s.add_argument("--start", required=True, help="first period, e.g. 2026-10, 2026-Q4, 2026-fall, 2026")
    g = s.add_mutually_exclusive_group(required=True)
    g.add_argument("--count", type=int, help="number of periods")
    g.add_argument("--until", help="last period, inclusive")
    s.set_defaults(fn=cmd_schedule)
    c = sp.add_parser("check", help="lint the tree; with --pr, verify the PR records what it closes")
    c.add_argument("--pr", type=int)
    c.set_defaults(fn=cmd_check)
    a = ap.parse_args()
    try:
        a.fn(a)
    except Refuse as r:
        sys.exit(str(r))


if __name__ == "__main__":
    main()
